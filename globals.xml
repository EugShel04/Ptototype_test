<globals>
  <fonts>
    <font name="normal" family="Montserrat" size="14"/>
    <font name="medium" family="Montserrat" size="16" weight="semi_bold"/>
    <font name="title" family="Montserrat" size="22" weight="bold"/>
    <font name="small" family="Montserrat" size="12"/>
  </fonts>

  <styles>
    <style name="screen_bg">
      <bg_color>0xf5f7fb</bg_color>
    </style>

    <style name="header_bar">
      <bg_color>0x1e293b</bg_color>
      <text_color>0xffffff</text_color>
      <pad_all>16</pad_all>
    </style>

    <style name="card">
      <bg_color>0xffffff</bg_color>
      <bg_opa>255</bg_opa>
      <radius>10</radius>
      <shadow_width>6</shadow_width>
      <shadow_opa>40</shadow_opa>
      <pad_all>16</pad_all>
    </style>

    <style name="metric_card">
      <bg_color>0xffffff</bg_color>
      <bg_opa>255</bg_opa>
      <radius>8</radius>
      <border_width>1</border_width>
      <border_color>0xe2e8f0</border_color>
      <pad_all>12</pad_all>
    </style>

    <style name="primary_button">
      <bg_color>0x2563eb</bg_color>
      <text_color>0xffffff</text_color>
      <radius>6</radius>
      <pad_hor>16</pad_hor>
      <pad_ver>8</pad_ver>
    </style>

    <style name="secondary_button">
      <bg_color>0xffffff</bg_color>
      <text_color>0x334155</text_color>
      <border_width>1</border_width>
      <border_color>0xcbd5e1</border_color>
      <radius>6</radius>
      <pad_hor>16</pad_hor>
      <pad_ver>8</pad_ver>
    </style>

    <style name="table_header">
      <bg_color>0xf1f5f9</bg_color>
      <text_color>0x0f172a</text_color>
      <text_font>medium</text_font>
      <pad_all>8</pad_all>
    </style>

    <style name="table_row">
      <bg_color>0xffffff</bg_color>
      <text_color>0x334155</text_color>
      <text_font>normal</text_font>
      <pad_all>8</pad_all>
      <border_width>0</border_width>
    </style>
  </styles>

  <consts>
    <string name="app_title" value="Отчёт по ECL"/>
    <string name="report_subtitle" value="IFRS 9 — Expected Credit Loss"/>
  </consts>
</globals>